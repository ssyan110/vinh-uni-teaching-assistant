{
  "name": "ai-teaching-material-system",
  "version": "0.2.0",
  "private": true,
  "description": "Reusable AI teaching-material production system. Supports any lesson type (regular, pinyin, etc.) and any course.",
  "scripts": {
    "validate": "node scripts/validate-system.mjs",
    "validate:lesson1": "node scripts/validate-system.mjs --lesson output/book-1/lesson-01",
    "validate:book1": "for d in output/book-1/lesson-*; do node scripts/validate-system.mjs --lesson \"$d\"; done",
    "lesson:shells": "node scripts/update-lesson-shell.mjs --all output/book-1",
    "lesson:presenter": "node scripts/sync-lesson-presenter.mjs --lesson",
    "assets:manifest": "node scripts/build-lesson-asset-manifest.mjs --lesson",
    "assets:qa": "node scripts/qa-lesson-assets.mjs --lesson",
    "assets:replace": "node scripts/replace-lesson-image.mjs",
    "assets:crop-contact-sheet": "node scripts/crop-vocab-contact-sheet.mjs",
    "slides:screenshot": "node scripts/render-slide-screenshot.mjs",
    "slides:pdf-data": "node scripts/build-slides-data.mjs --slides-dir",
    "slides:pdf": "node scripts/export-slides-pdf.mjs --slides-dir",
    "slides:watch": "node scripts/watch-slides.mjs --slides-dir",
    "lesson1:pdf-data": "node scripts/build-slides-data.mjs --slides-dir output/book-1/lesson-01/slides",
    "lesson1:pdf": "node scripts/export-slides-pdf.mjs --slides-dir output/book-1/lesson-01/slides",
    "lesson1:watch": "node scripts/watch-slides.mjs --slides-dir output/book-1/lesson-01/slides",
    "vp:run": ".venv/bin/python scripts/run_pipeline.py",
    "vp:pinyin:l1": ".venv/bin/python scripts/run_pipeline.py --lesson-type pinyin --lesson-id pinyin-01 --lesson-title 'Pinyin · Bài 1' --source-pdf 'Pinyin lessons/pinyin-l1.14102024210713.pdf' --output-dir output/pinyin/pinyin-01/database/ --content-file work/design-ref-pinyin-l1/extract.json",
    "pinyin:l1:steps10-12": "node scripts/generate-pinyin-01-steps10-12.mjs",
    "pinyin:l2:steps10-13": "node scripts/generate-pinyin-02-steps10-13.mjs",
    "pinyin:l3:steps10-13": "node scripts/generate-pinyin-03-steps10-13.mjs",
    "create:deck": "node scripts/create-teacher-deck.mjs"
  },
  "dependencies": {
    "@playwright/test": "latest",
    "pdf-lib": "latest",
    "playwright": "^1.60.0",
    "sharp": "latest"
  }
}
