  "tone_sandhi_rules": [
    {
      "item_id": "rule_l3_yi_bu_tone_sandhi",
      "page": "P14",
      "title": "一不變調",
      "explanation": "一、不在特定語音環境中會改變聲調；練習目標是能正確朗讀與聽辨。",
      "rule_details": [
        {
          "base_form": "一",
          "base_pinyin": "yī",
          "condition": "讀順序時，例如星期一、第一、一樓",
          "spoken_pinyin": "yī",
          "note": "讀星期一、第一、一樓等順序用語時，一念一聲。"
        },
        {
          "base_form": "一",
          "base_pinyin": "yī",
          "condition": "逐一讀數字 1，例如電話號碼或年份",
          "spoken_pinyin": "yī",
          "note": "讀電話號碼、年份、編號中的數字 1 時，通常念一聲。"
        },
        {
          "base_form": "一",
          "base_pinyin": "yī",
          "condition": "後面接第四聲",
          "spoken_pinyin": "yí",
          "note": "一 + 四聲時常讀二聲。"
        },
        {
          "base_form": "一",
          "base_pinyin": "yī",
          "condition": "後面接第一、二、三聲",
          "spoken_pinyin": "yì",
          "note": "一 + 非四聲時常讀四聲。"
        },
        {
          "base_form": "不",
          "base_pinyin": "bù",
          "condition": "後面接第四聲",
          "spoken_pinyin": "bú",
          "note": "不 + 四聲時讀二聲。"
        },
        {
          "base_form": "不",
          "base_pinyin": "bù",
          "condition": "其他情況",
          "spoken_pinyin": "bù",
          "note": "其他情況通常維持四聲。"
        }
      ]
    }
  ],
