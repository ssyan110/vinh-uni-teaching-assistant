  "tone_sandhi_rules": [
    {
      "item_id": "rule_l3_yi_bu_tone_sandhi",
      "page": "P14",
      "title": "一不变调",
      "explanation": "一、不在特定语音环境中会改变声调；练习目标是能正确朗读与听辨。",
      "rule_details": [
        {
          "base_form": "一",
          "base_pinyin": "yī",
          "condition": "读顺序时，例如星期一、第一、一楼",
          "spoken_pinyin": "yī",
          "note": "读星期一、第一、一楼等顺序用语时，一念一声。"
        },
        {
          "base_form": "一",
          "base_pinyin": "yī",
          "condition": "逐一读数字 1，例如电话号码或年份",
          "spoken_pinyin": "yī",
          "note": "读电话号码、年份、编号中的数字 1 时，通常念一声。"
        },
        {
          "base_form": "一",
          "base_pinyin": "yī",
          "condition": "后面接第四声",
          "spoken_pinyin": "yí",
          "note": "一 + 四声时常读二声。"
        },
        {
          "base_form": "一",
          "base_pinyin": "yī",
          "condition": "后面接第一、二、三声",
          "spoken_pinyin": "yì",
          "note": "一 + 非四声时常读四声。"
        },
        {
          "base_form": "不",
          "base_pinyin": "bù",
          "condition": "后面接第四声",
          "spoken_pinyin": "bú",
          "note": "不 + 四声时读二声。"
        },
        {
          "base_form": "不",
          "base_pinyin": "bù",
          "condition": "其他情况",
          "spoken_pinyin": "bù",
          "note": "其他情况通常维持四声。"
        }
      ]
    }
  ],
