["<div class=\"os-page\" data-idx=\"0\"><div data-osd-source-slides=\"1\" data-osd-stable-id=\"v02-cover\" data-slide-loc=\"317:33\" style='width: 1920px; height: 1080px; box-sizing: border-box; padding: 110px 96px 68px; background: rgb(255, 255, 255); color: rgb(16, 42, 67); font-family: KaiTi, STKaiti, 楷体, \"Times New Roman\", serif; position: relative; overflow: hidden;'><div data-slide-loc=\"318:4\" style=\"position: absolute; top: 84px; left: 96px; color: rgb(8, 126, 139); font-size: 45px; font-weight: 700; letter-spacing: 1px;\">第11–12课 · 实体课</div><div data-slide-loc=\"319:4\" style=\"height: 100%; display: grid; grid-template-columns: 1.1fr 0.9fr; align-items: center; gap: 50px;\"><div data-slide-loc=\"320:6\" style=\"padding-bottom: 45px;\"><h1 data-osd-step=\"true\" data-slide-loc=\"320:41\" style=\"margin: 0px; font-size: 82px; line-height: 1.12; letter-spacing: -2px; font-weight: 760;\">天气、动作与安排</h1><div data-slide-loc=\"320:163\" style=\"margin-top: 34px; width: 90px; height: 8px; border-radius: 4px; background: rgb(8, 126, 139);\"></div><p data-osd-step=\"true\" data-slide-loc=\"320:253\" style=\"margin: 34px 0px 0px; max-width: 900px; font-size: 48px; line-height: 1.35; color: rgb(82, 101, 121);\">听懂天气和消息，和同伴说清楚安排。</p><div data-osd-step=\"true\" data-slide-loc=\"320:378\" style=\"margin-top: 38px; font-size: 45px; line-height: 1.25; font-weight: 650; color: rgb(8, 126, 139);\">天气选择 · 电话确认 · 六格故事</div></div><div data-osd-step=\"true\" data-slide-loc=\"321:6\" style=\"height: 620px; display: grid; place-items: center; border-left: 1px solid rgb(217, 227, 232);\"><img alt=\"bus\" data-slide-loc=\"282:9\" src=\"assets/bus.png\" style=\"width: 690px; height: 590px; object-fit: contain;\"/></div></div><div data-slide-loc=\"322:10\" style=\"position: absolute; bottom: 96px; left: 96px; right: 96px; display: flex; justify-content: space-between; color: rgb(82, 101, 121); font-size: 30px;\"><span data-slide-loc=\"322:159\">博雅汉语 · 初级口语活动</span><span data-slide-loc=\"322:185\">01 / 30</span></div></div></div>", "<div class=\"os-page\" data-idx=\"1\" hidden=\"\"><section class=\"route\" data-osd-stable-id=\"v02-route\" style=\"width:1920px;height:1080px;box-sizing:border-box;padding:80px 96px;background:white;color:#17324d;font-family:KaiTi,'Times New Roman',serif\"><h1 style=\"font-size:74px;margin:0 0 42px\">今天我们会做什么</h1><div style=\"display:grid;grid-template-columns:repeat(3,1fr);gap:28px\"><article data-osd-step=\"true\" style=\"background:#f8fbfb;border:1px solid #d8e7e9;border-radius:20px;padding:20px\"><p class=\"route-number\">活动11-1—11-2</p><div class=\"route-keyword\" style=\"height:180px;display:flex;align-items:center;justify-content:center;font-size:64px;font-weight:700;color:#087e8b\">听天气</div><h2 style=\"font-size:40px;margin:16px 0;color:#087e8b\">听天气，选出门安排</h2></article><article data-osd-step=\"true\" style=\"background:#f8fbfb;border:1px solid #d8e7e9;border-radius:20px;padding:20px\"><p class=\"route-number\">活动11-3</p><div class=\"route-keyword\" style=\"height:180px;display:flex;align-items:center;justify-content:center;font-size:64px;font-weight:700;color:#087e8b\">讲天气故事</div><h2 style=\"font-size:40px;margin:16px 0;color:#087e8b\">天气变了：六格故事</h2></article><article data-osd-step=\"true\" style=\"background:#f8fbfb;border:1px solid #d8e7e9;border-radius:20px;padding:20px\"><p class=\"route-number\">活动11-4—11-6</p><div class=\"route-keyword\" style=\"height:180px;display:flex;align-items:center;justify-content:center;font-size:64px;font-weight:700;color:#087e8b\">改出门安排</div><h2 style=\"font-size:40px;margin:16px 0;color:#087e8b\">选城市，改安排，发通知</h2></article><article data-osd-step=\"true\" style=\"background:#f8fbfb;border:1px solid #d8e7e9;border-radius:20px;padding:20px\"><p class=\"route-number\">活动12-1—12-3</p><div class=\"route-keyword\" style=\"height:180px;display:flex;align-items:center;justify-content:center;font-size:64px;font-weight:700;color:#087e8b\">问当前状态</div><h2 style=\"font-size:40px;margin:16px 0;color:#087e8b\">分清动作，听消息，打电话</h2></article><article data-osd-step=\"true\" style=\"background:#f8fbfb;border:1px solid #d8e7e9;border-radius:20px;padding:20px\"><p class=\"route-number\">活动12-4</p><div class=\"route-keyword\" style=\"height:180px;display:flex;align-items:center;justify-content:center;font-size:64px;font-weight:700;color:#087e8b\">讲等车故事</div><h2 style=\"font-size:40px;margin:16px 0;color:#087e8b\">还在路上：六格故事</h2></article><article data-osd-step=\"true\" style=\"background:#f8fbfb;border:1px solid #d8e7e9;border-radius:20px;padding:20px\"><p class=\"route-number\">活动12-5—12-8</p><div class=\"route-keyword\" style=\"height:180px;display:flex;align-items:center;justify-content:center;font-size:64px;font-weight:700;color:#087e8b\">更新课表</div><h2 style=\"font-size:40px;margin:16px 0;color:#087e8b\">更新课表，转告新安排</h2></article></div></section></div>", "<div class=\"os-page\" data-activity=\"11-1\" data-idx=\"2\" data-kind=\"task\" hidden=\"\"><section class=\"activity task\" data-osd-stable-id=\"v02-11-1-task\"><header><div class=\"lesson-tag\">第11课 · 实体课</div><div class=\"activity-label\">活动11-1｜听天气，选时间</div><h1>听天气，选时间</h1><div class=\"rule\"></div></header><p class=\"goal\" data-osd-step=\"\"><span>目标</span>听懂天气和温度，告诉同桌什么时候去公园。</p><div class=\"task-grid\"><ol class=\"task-steps\"><li data-osd-step=\"\">先看第二页的三道问题。听老师读<span class=\"no-wrap\">天气预报</span>，自己记三个时段的天气和温度。</li><li data-osd-step=\"\">和同桌核对记录；不同的地方再听一次。</li><li data-osd-step=\"\">轮流说：选哪个时段去公园，为什么。</li></ol><aside><article class=\"level base\" data-osd-step=\"\"><h2>基础 <span>HSK 1–3</span></h2><p>说清一个时段、天气和选择理由。</p></article><article class=\"level challenge\" data-osd-step=\"\"><h2>挑战 <span>HSK 4–6</span></h2><p>比较两个时段；回应同桌的不同选择。</p></article></aside></div><p class=\"done\"><b>完成</b> 每人一份天气记录；每人说一个选择和理由。</p><footer><span>博雅汉语 · 初级口语活动</span><span>03 / 30</span></footer></section></div>", "<div class=\"os-page\" data-activity=\"11-1\" data-idx=\"3\" data-kind=\"data\" hidden=\"\"><section class=\"activity data\" data-osd-stable-id=\"v02-11-1-data\"><header><div class=\"lesson-tag\">第11课 · 实体课</div><div class=\"activity-label\">活动11-1｜听天气，选时间</div><h1>听天气，选时间</h1><div class=\"rule\"></div></header><div class=\"material split\"><div class=\"table-side\" data-osd-step=\"\"><table><thead><tr><th>时段</th><th>天气</th><th>温度</th></tr></thead><tbody><tr><td>上午</td><td>　</td><td>　</td></tr><tr><td>下午</td><td>　</td><td>　</td></tr><tr><td>晚上</td><td>　</td><td>　</td></tr></tbody></table></div><div class=\"question-side\" data-osd-step=\"\"><p>听老师读明天的<span class=\"no-wrap\">天气预报</span>。</p><ol><li>上午、下午、晚上：天气怎么样？多少度？</li><li>哪个时段<span class=\"no-wrap\">下雨</span>？</li><li>你想什么时候去公园？为什么？</li></ol><p>可用：我想……去公园。……，我觉得……。</p></div></div><footer><span>博雅汉语 · 初级口语活动</span><span>04 / 30</span></footer></section></div>", "<div class=\"os-page\" data-activity=\"11-2\" data-idx=\"4\" data-kind=\"task\" hidden=\"\"><section class=\"activity task\" data-osd-stable-id=\"v02-11-2-task\"><header><div class=\"lesson-tag\">第11课 · 实体课</div><div class=\"activity-label\">活动11-2｜一起选出门安排</div><h1>一起选出门安排</h1><div class=\"rule\"></div></header><p class=\"goal\" data-osd-step=\"\"><span>目标</span>用天气和喜好，和同桌确定一个共同安排。</p><div class=\"task-grid\"><ol class=\"task-steps\"><li data-osd-step=\"\">看第二页三个安排。各自先选一个，想好理由。</li><li data-osd-step=\"\">轮流告诉同桌：什么时候去、做什么、为什么。</li><li data-osd-step=\"\">选择不同，就说明理由；一起选定一个安排，再各说一次。</li></ol><aside><article class=\"level base\" data-osd-step=\"\"><h2>基础 <span>HSK 1–3</span></h2><p>说清时间、活动和一个天气理由；回答同桌一个问题。</p></article><article class=\"level challenge\" data-osd-step=\"\"><h2>挑战 <span>HSK 4–6</span></h2><p>比较两个安排；回应同桌的理由，提出双方能接受的办法。</p></article></aside></div><p class=\"done\"><b>完成</b> 两人各说出同一个最终安排和理由。</p><footer><span>博雅汉语 · 初级口语活动</span><span>05 / 30</span></footer></section></div>", "<div class=\"os-page\" data-activity=\"11-2\" data-idx=\"5\" data-kind=\"data\" hidden=\"\"><section class=\"activity data\" data-osd-stable-id=\"v02-11-2-data\"><header><div class=\"lesson-tag\">第11课 · 实体课</div><div class=\"activity-label\">活动11-2｜一起选出门安排</div><h1>一起选出门安排</h1><div class=\"rule\"></div></header><div class=\"material wide\"><div class=\"data-cards\"><article data-osd-step=\"\"><h2>上午9:00</h2><p>晴，24度</p><p>公园散步</p></article><article data-osd-step=\"\"><h2>下午3:00</h2><p>雨，28度</p><p>商场<span class=\"no-wrap\">逛街</span></p></article><article data-osd-step=\"\"><h2>晚上7:00</h2><p>阴，22度，有风</p><p>商场<span class=\"no-wrap\">逛街</span></p></article></div><p>明天的三个安排</p><p>想一想：喜欢<span class=\"no-wrap\">晴天</span>、不喜欢太热的人会怎么选？喜欢<span class=\"no-wrap\">逛街</span>的人呢？</p><p>问同桌：你选哪个？为什么？我们一起什么时候去，做什么？</p><p>可用：我想……。我觉得……<span class=\"no-wrap\">太……了</span>。可是……。那我们……吧。</p></div><footer><span>博雅汉语 · 初级口语活动</span><span>06 / 30</span></footer></section></div>", "<div class=\"os-page\" data-activity=\"11-3\" data-idx=\"6\" data-kind=\"task\" hidden=\"\"><section class=\"activity task\" data-osd-stable-id=\"v02-11-3-task\"><header><div class=\"lesson-tag\">第11课 · 实体课</div><div class=\"activity-label\">活动11-3｜六格漫画：天气变了</div><h1>六格漫画：天气变了</h1><div class=\"rule\"></div></header><p class=\"goal\" data-osd-step=\"\"><span>目标</span>用本课词语，讲清天气变化和人物活动。</p><div class=\"task-grid\"><ol class=\"task-steps\"><li data-osd-step=\"\">看第二页六格漫画。A讲①②③，B讲④⑤⑥。</li><li data-osd-step=\"\">再轮流各讲完整六格；听者问一处不清楚的地方。</li><li data-osd-step=\"\">回答后，把不清楚的部分再讲一次。</li></ol><aside><article class=\"level base\" data-osd-step=\"\"><h2>基础 <span>HSK 1–3</span></h2><p>每格说清发生什么；用天气词和“<span class=\"no-wrap\">太……了</span>”表达感受。</p></article><article class=\"level challenge\" data-osd-step=\"\"><h2>挑战 <span>HSK 4–6</span></h2><p>解释天气怎样影响活动；加入合理的人物想法，回答“为什么”。</p></article></aside></div><p class=\"done\"><b>完成</b> 每人讲完整故事；同桌能说出天气变化和最后的活动。</p><footer><span>博雅汉语 · 初级口语活动</span><span>07 / 30</span></footer></section></div>", "<div class=\"os-page\" data-activity=\"11-3\" data-idx=\"7\" data-kind=\"data\" hidden=\"\"><section class=\"activity data\" data-osd-stable-id=\"v02-11-3-data\"><header><div class=\"lesson-tag\">第11课 · 实体课</div><div class=\"activity-label\">活动11-3｜六格漫画：天气变了</div><h1>六格漫画：天气变了</h1><div class=\"rule\"></div></header><div class=\"comic-grid\"><div class=\"comic\" data-osd-step=\"\"><img alt=\"第11课六格漫画，按①至⑥讲述\" src=\"assets/story-lesson-11.png\"/><span class=\"panel-label\" style=\"left:0.0%;top:0%\">① 看预报</span><span class=\"panel-label\" style=\"left:33.333333333333336%;top:0%\">② 公园散步</span><span class=\"panel-label\" style=\"left:66.66666666666667%;top:0%\">③ 觉得热</span><span class=\"panel-label\" style=\"left:0.0%;top:50%\">④ <span class=\"no-wrap\">阴天</span><span class=\"no-wrap\">刮风</span></span><span class=\"panel-label\" style=\"left:33.333333333333336%;top:50%\">⑤ <span class=\"no-wrap\">下雨</span>避雨</span><span class=\"panel-label\" style=\"left:66.66666666666667%;top:50%\">⑥ 商场<span class=\"no-wrap\">逛街</span></span></div><aside class=\"comic-prompts\"><p class=\"context\" data-osd-step=\"\">天气预报：上午晴<span class=\"no-wrap\">24度</span>／下午雨<span class=\"no-wrap\">28度</span>。</p><h2>讲述提示</h2><p data-osd-step=\"\">①预报说什么？②③在哪里、感觉怎样？<br/>④⑤天气怎样变？⑥最后做什么？</p><h2>可用词句</h2><p class=\"words\" data-osd-step=\"\"><span class=\"no-wrap\">天气预报</span>｜<span class=\"no-wrap\">晴天</span>｜热｜<span class=\"no-wrap\">阴天</span>｜<span class=\"no-wrap\">刮风</span>｜<span class=\"no-wrap\">下雨</span>｜<span class=\"no-wrap\">逛街</span>｜<span class=\"no-wrap\">太……了</span></p></aside></div><footer><span>博雅汉语 · 初级口语活动</span><span>08 / 30</span></footer></section></div>", "<div class=\"os-page\" data-activity=\"11-4\" data-idx=\"8\" data-kind=\"task\" hidden=\"\"><section class=\"activity task\" data-osd-stable-id=\"v02-11-4-task\"><header><div class=\"lesson-tag\">第11课 · 实体课</div><div class=\"activity-label\">活动11-4｜三个城市，你想去哪儿</div><h1>三个城市，你想去哪儿</h1><div class=\"rule\"></div></header><p class=\"goal\" data-osd-step=\"\"><span>目标</span>比较天气、季节和温度，说自己的选择。</p><div class=\"task-grid\"><ol class=\"task-steps\"><li data-osd-step=\"\">看第二页三个城市的天气，各选一个想去的城市。</li><li data-osd-step=\"\">轮流告诉同桌天气和理由；各问对方一个天气问题。</li><li data-osd-step=\"\">听完回答，保留或改变选择，再说明理由。</li></ol><aside><article class=\"level base\" data-osd-step=\"\"><h2>基础 <span>HSK 1–3</span></h2><p>说城市、天气、温度和喜好；回答一个问题。</p></article><article class=\"level challenge\" data-osd-step=\"\"><h2>挑战 <span>HSK 4–6</span></h2><p>比较两个城市；回应不同喜好，说清是否改变选择。</p></article></aside></div><p class=\"done\"><b>完成</b> 每人说最终选择；同桌能复述城市和理由。</p><footer><span>博雅汉语 · 初级口语活动</span><span>09 / 30</span></footer></section></div>", "<div class=\"os-page\" data-activity=\"11-4\" data-idx=\"9\" data-kind=\"data\" hidden=\"\"><section class=\"activity data\" data-osd-stable-id=\"v02-11-4-data\"><header><div class=\"lesson-tag\">第11课 · 实体课</div><div class=\"activity-label\">活动11-4｜三个城市，你想去哪儿</div><h1>三个城市，你想去哪儿</h1><div class=\"rule\"></div></header><div class=\"material split\"><div class=\"table-side\" data-osd-step=\"\"><table><thead><tr><th>城市</th><th>季节／天气</th><th>温度</th></tr></thead><tbody><tr><td>北京</td><td>冬天，下雪</td><td>零下5度</td></tr><tr><td>曼谷</td><td><span class=\"no-wrap\">晴天</span></td><td>32度</td></tr><tr><td>悉尼</td><td>夏天，<span class=\"no-wrap\">晴天</span></td><td>25度</td></tr></tbody></table></div><div class=\"question-side\" data-osd-step=\"\"><p>12月的一天</p><p>①哪个最冷，哪个最热？②你最想去哪儿，为什么？③你喜欢下雪还是<span class=\"no-wrap\">晴天</span>？④听了同桌的理由，你想改变选择吗？</p><p>可用：我最喜欢……。我觉得……<span class=\"no-wrap\">太……了</span>。你为什么喜欢……？</p></div></div><footer><span>博雅汉语 · 初级口语活动</span><span>10 / 30</span></footer></section></div>", "<div class=\"os-page\" data-activity=\"11-5\" data-idx=\"10\" data-kind=\"task\" hidden=\"\"><section class=\"activity task\" data-osd-stable-id=\"v02-11-5-task\"><header><div class=\"lesson-tag\">第11课 · 实体课</div><div class=\"activity-label\">活动11-5｜听新预报，改变安排</div><h1>听新预报，改变安排</h1><div class=\"rule\"></div></header><p class=\"goal\" data-osd-step=\"\"><span>目标</span>听新<span class=\"no-wrap\">天气预报</span>，决定要不要改变原计划。</p><div class=\"task-grid\"><ol class=\"task-steps\"><li data-osd-step=\"\">看第二页原计划和四道问题，听老师读周日预报。</li><li data-osd-step=\"\">独立记上午、下午的天气和温度；与同桌核对。</li><li data-osd-step=\"\">轮流提一个新安排，说理由；听者复述，讲错就修正。</li></ol><aside><article class=\"level base\" data-osd-step=\"\"><h2>基础 <span>HSK 1–3</span></h2><p>记对两个时段；选一个安排，说天气理由。</p></article><article class=\"level challenge\" data-osd-step=\"\"><h2>挑战 <span>HSK 4–6</span></h2><p>比较新旧安排；回应同桌意见，说清改变或保留的理由。</p></article></aside></div><p class=\"done\"><b>完成</b> 每人一份听记和一次新安排；同桌能复述。</p><footer><span>博雅汉语 · 初级口语活动</span><span>11 / 30</span></footer></section></div>", "<div class=\"os-page\" data-activity=\"11-5\" data-idx=\"11\" data-kind=\"data\" hidden=\"\"><section class=\"activity data\" data-osd-stable-id=\"v02-11-5-data\"><header><div class=\"lesson-tag\">第11课 · 实体课</div><div class=\"activity-label\">活动11-5｜听新预报，改变安排</div><h1>听新预报，改变安排</h1><div class=\"rule\"></div></header><div class=\"material split\"><div class=\"table-side\" data-osd-step=\"\"><table><thead><tr><th>时段</th><th>天气</th><th>温度</th></tr></thead><tbody><tr><td>周日上午</td><td>　</td><td>　</td></tr><tr><td>周日下午</td><td>　</td><td>　</td></tr></tbody></table></div><div class=\"question-side\" data-osd-step=\"\"><p>原计划：周日下午3:00去公园散步。</p><p>听前问：①上午天气怎么样、多少度？②下午呢？③原计划合适吗？④你建议怎么安排？</p><p>可选：上午9:00公园／下午3:00公园／下午3:00商场。</p><p>可用：原来想……。现在……。我想……。</p></div></div><footer><span>博雅汉语 · 初级口语活动</span><span>12 / 30</span></footer></section></div>", "<div class=\"os-page\" data-activity=\"11-6\" data-idx=\"12\" data-kind=\"task\" hidden=\"\"><section class=\"activity task\" data-osd-stable-id=\"v02-11-6-task\"><header><div class=\"lesson-tag\">第11课 · 实体课</div><div class=\"activity-label\">活动11-6｜通知同学，确认安排</div><h1>通知同学，确认安排</h1><div class=\"rule\"></div></header><p class=\"goal\" data-osd-step=\"\"><span>目标</span>把新安排说清楚，让同桌知道何时何地见面。</p><div class=\"task-grid\"><ol class=\"task-steps\"><li data-osd-step=\"\">B先在纸上写：哪一天／几点见面／在哪里／做什么／几点结束。A看第二页通知资料；B背对屏幕，只听。</li><li data-osd-step=\"\">A说完整通知；B记关键词，复述并问一个确认问题。</li><li data-osd-step=\"\">A回答并纠正；交换角色，各再通知一次。</li></ol><aside><article class=\"level base\" data-osd-step=\"\"><h2>基础 <span>HSK 1–3</span></h2><p>说清日期、见面时间、地点、活动和结束时间。</p></article><article class=\"level challenge\" data-osd-step=\"\"><h2>挑战 <span>HSK 4–6</span></h2><p>再解释为什么改安排；主动检查听者有没有听错。</p></article></aside></div><p class=\"done\"><b>完成</b> 每人通知一次、听一次；听者记录准确。</p><footer><span>博雅汉语 · 初级口语活动</span><span>13 / 30</span></footer></section></div>", "<div class=\"os-page\" data-activity=\"11-6\" data-idx=\"13\" data-kind=\"data\" hidden=\"\"><section class=\"activity data\" data-osd-stable-id=\"v02-11-6-data\"><header><div class=\"lesson-tag\">第11课 · 实体课</div><div class=\"activity-label\">活动11-6｜通知同学，确认安排</div><h1>通知同学，确认安排</h1><div class=\"rule\"></div></header><div class=\"material split\"><div class=\"table-side\" data-osd-step=\"\"><table><thead><tr><th>项目</th><th>信息</th></tr></thead><tbody><tr><td>见面</td><td>周日上午9:00，学校门口</td></tr><tr><td>活动</td><td>去公园散步</td></tr><tr><td>结束</td><td>上午11:00</td></tr><tr><td>原计划</td><td>周日下午3:00去公园</td></tr><tr><td>天气</td><td>上午晴23度；下午阴、<span class=\"no-wrap\">下雨</span>27度</td></tr></tbody></table></div><div class=\"question-side\" data-osd-step=\"\"><p>周日最终安排</p><p>听者先在纸上写：哪一天／几点见面／在哪里／做什么／几点结束。</p><p>确认：我们几点见面？在哪里见面？几点结束？</p></div></div><footer><span>博雅汉语 · 初级口语活动</span><span>14 / 30</span></footer></section></div>", "<div class=\"os-page\" data-activity=\"12-1\" data-idx=\"14\" data-kind=\"task\" hidden=\"\"><section class=\"activity task\" data-osd-stable-id=\"v02-12-1-task\"><header><div class=\"lesson-tag\">第12课 · 实体课</div><div class=\"activity-label\">活动12-1｜平时做什么，现在呢</div><h1>平时做什么，现在呢</h1><div class=\"rule\"></div></header><p class=\"goal\" data-osd-step=\"\"><span>目标</span>分清每天的习惯和现在正在做的事。</p><div class=\"task-grid\"><ol class=\"task-steps\"><li data-osd-step=\"\">看第二页，选两个人，先自己想怎么介绍。</li><li data-osd-step=\"\">轮流说给同桌听；听者问“现在在哪儿，正在干什么”。</li><li data-osd-step=\"\">回答后补说第三个人；听者复述一人的现在情况。</li></ol><aside><article class=\"level base\" data-osd-step=\"\"><h2>基础 <span>HSK 1–3</span></h2><p>用“<span class=\"no-wrap\">每……都……</span>”和“<span class=\"no-wrap\">正在……呢</span>”说两个人。</p></article><article class=\"level challenge\" data-osd-step=\"\"><h2>挑战 <span>HSK 4–6</span></h2><p>判断现在的事是否真的与习惯不同；解释依据，回答追问。</p></article></aside></div><p class=\"done\"><b>完成</b> 两人讲清三个人；每人回答一次，听者复述正确。</p><footer><span>博雅汉语 · 初级口语活动</span><span>15 / 30</span></footer></section></div>", "<div class=\"os-page\" data-activity=\"12-1\" data-idx=\"15\" data-kind=\"data\" hidden=\"\"><section class=\"activity data\" data-osd-stable-id=\"v02-12-1-data\"><header><div class=\"lesson-tag\">第12课 · 实体课</div><div class=\"activity-label\">活动12-1｜平时做什么，现在呢</div><h1>平时做什么，现在呢</h1><div class=\"rule\"></div></header><div class=\"material split\"><div class=\"table-side\" data-osd-step=\"\"><table><thead><tr><th>人物</th><th>平时</th><th>现在</th></tr></thead><tbody><tr><td><span class=\"no-wrap\">小林</span></td><td>每天坐公共汽车去学校</td><td>车站等公共汽车</td></tr><tr><td><span class=\"no-wrap\">小美</span></td><td>每天下午在教室做作业</td><td>宿舍上网</td></tr><tr><td><span class=\"no-wrap\">小王</span></td><td>每天晚上看电影</td><td>教室做作业</td></tr></tbody></table></div><div class=\"question-side\" data-osd-step=\"\"><p>今天星期三，下午2:00。</p><p>①<span class=\"no-wrap\">小林</span>每天怎么去学校，现在做什么？②<span class=\"no-wrap\">小美</span>平时下午做什么，现在在哪儿？③<span class=\"no-wrap\">小王</span>现在在看电影吗？</p><p>挑战：<span class=\"no-wrap\">小王</span>现在做作业，能说明今天晚上不看电影吗？为什么？</p></div></div><footer><span>博雅汉语 · 初级口语活动</span><span>16 / 30</span></footer></section></div>", "<div class=\"os-page\" data-activity=\"12-2\" data-idx=\"16\" data-kind=\"task\" hidden=\"\"><section class=\"activity task\" data-osd-stable-id=\"v02-12-2-task\"><header><div class=\"lesson-tag\">第12课 · 实体课</div><div class=\"activity-label\">活动12-2｜听三条消息，说清人在做什么</div><h1>听三条消息，说清人在做什么</h1><div class=\"rule\"></div></header><p class=\"goal\" data-osd-step=\"\"><span>目标</span>听懂三人的地点、动作和下一步安排。</p><div class=\"task-grid\"><ol class=\"task-steps\"><li data-osd-step=\"\">先看第二页四道问题；听老师读<span class=\"no-wrap\">小林</span>、<span class=\"no-wrap\">小美</span>、<span class=\"no-wrap\">小王</span>的三条消息。</li><li data-osd-step=\"\">自己记地点、动作、时间；再听核对。</li><li data-osd-step=\"\">和同桌比较；不同就说清要重听哪一人的哪项信息。</li><li data-osd-step=\"\">轮流介绍三人；听者指出错处，修正后重说。</li></ol><aside><article class=\"level base\" data-osd-step=\"\"><h2>基础 <span>HSK 1–3</span></h2><p>说对三人的地点、正在做的事和下一步安排。</p></article><article class=\"level challenge\" data-osd-step=\"\"><h2>挑战 <span>HSK 4–6</span></h2><p>现在要打电话问作业：先找谁？用消息说明理由。</p></article></aside></div><p class=\"done\"><b>完成</b> 每人一份状态记录、一次介绍；挑战另说选择依据。</p><footer><span>博雅汉语 · 初级口语活动</span><span>17 / 30</span></footer></section></div>", "<div class=\"os-page\" data-activity=\"12-2\" data-idx=\"17\" data-kind=\"data\" hidden=\"\"><section class=\"activity data\" data-osd-stable-id=\"v02-12-2-data\"><header><div class=\"lesson-tag\">第12课 · 实体课</div><div class=\"activity-label\">活动12-2｜听三条消息，说清人在做什么</div><h1>听三条消息，说清人在做什么</h1><div class=\"rule\"></div></header><div class=\"material split\"><div class=\"table-side\" data-osd-step=\"\"><table><thead><tr><th>人物</th><th>地点</th><th>现在做什么</th><th>下一步／时间</th></tr></thead><tbody><tr><td><span class=\"no-wrap\">小林</span></td><td>　</td><td>　</td><td>　</td></tr><tr><td><span class=\"no-wrap\">小美</span></td><td>　</td><td>　</td><td>　</td></tr><tr><td><span class=\"no-wrap\">小王</span></td><td>　</td><td>　</td><td>　</td></tr></tbody></table></div><div class=\"question-side\" data-osd-step=\"\"><p>今天下午1:40。听老师读三人的消息。</p><p>①<span class=\"no-wrap\">小林</span>在哪儿，正在干什么？②<span class=\"no-wrap\">小美</span>呢？③<span class=\"no-wrap\">小王</span>呢？④每人接下来要做什么，什么时候？</p><p>挑战：现在找谁打电话问作业？谁明确说能接电话？谁没说？</p></div></div><footer><span>博雅汉语 · 初级口语活动</span><span>18 / 30</span></footer></section></div>", "<div class=\"os-page\" data-activity=\"12-3\" data-idx=\"18\" data-kind=\"task\" hidden=\"\"><section class=\"activity task\" data-osd-stable-id=\"v02-12-3-task\"><header><div class=\"lesson-tag\">第12课 · 实体课</div><div class=\"activity-label\">活动12-3｜打电话，确认到校时间</div><h1>打电话，确认到校时间</h1><div class=\"rule\"></div></header><p class=\"goal\" data-osd-step=\"\"><span>目标</span>询问位置、动作和到校时间，确认是否会晚到。</p><div class=\"task-grid\"><ol class=\"task-steps\"><li data-osd-step=\"\">在纸上记要问的三项：哪里、做什么、几点到。A先背对屏幕，B看第二页。</li><li data-osd-step=\"\">A打电话问三项；B回答。A重复到达时间，请B确认。</li><li data-osd-step=\"\">挑战再问晚到怎么办；交换角色重练。</li></ol><aside><article class=\"level base\" data-osd-step=\"\"><h2>基础 <span>HSK 1–3</span></h2><p>问清三项，重复时间并得到确认。</p></article><article class=\"level challenge\" data-osd-step=\"\"><h2>挑战 <span>HSK 4–6</span></h2><p>比较到达和上课时间；问晚到怎么办，商量一个办法。</p></article></aside></div><p class=\"done\"><b>完成</b> 每人问一次、答一次；两人确认到达时间。</p><footer><span>博雅汉语 · 初级口语活动</span><span>19 / 30</span></footer></section></div>", "<div class=\"os-page\" data-activity=\"12-3\" data-idx=\"19\" data-kind=\"data\" hidden=\"\"><section class=\"activity data\" data-osd-stable-id=\"v02-12-3-data\"><header><div class=\"lesson-tag\">第12课 · 实体课</div><div class=\"activity-label\">活动12-3｜打电话，确认到校时间</div><h1>打电话，确认到校时间</h1><div class=\"rule\"></div></header><div class=\"material split\"><div class=\"table-side\" data-osd-step=\"\"><table><thead><tr><th>人物</th><th>当前情况</th></tr></thead><tbody><tr><td>A</td><td>教室，正在做作业</td></tr><tr><td>B</td><td>车站，正在等公共汽车；预计2:10到教室</td></tr></tbody></table></div><div class=\"question-side\" data-osd-step=\"\"><p>现在下午1:40；课从下午2:00到4:00。</p><p>问：你在哪儿？正在干什么呢？什么时候到教室？</p><p>确认：你是说……到，对吗？</p><p>挑战：课几点<span class=\"no-wrap\">开始</span>？会晚到吗？谁可以告诉老师？</p></div></div><footer><span>博雅汉语 · 初级口语活动</span><span>20 / 30</span></footer></section></div>", "<div class=\"os-page\" data-activity=\"12-4\" data-idx=\"20\" data-kind=\"task\" hidden=\"\"><section class=\"activity task\" data-osd-stable-id=\"v02-12-4-task\"><header><div class=\"lesson-tag\">第12课 · 实体课</div><div class=\"activity-label\">活动12-4｜六格漫画：还在路上</div><h1>六格漫画：还在路上</h1><div class=\"rule\"></div></header><p class=\"goal\" data-osd-step=\"\"><span>目标</span>用本课句式，讲清等车、打电话和到校的经过。</p><div class=\"task-grid\"><ol class=\"task-steps\"><li data-osd-step=\"\">看第二页六格漫画。A讲①②③，B讲④⑤⑥。</li><li data-osd-step=\"\">轮流各讲完整故事；听者问一处时间或动作。</li><li data-osd-step=\"\">回答后，把说错或不清楚的部分再讲一次。</li></ol><aside><article class=\"level base\" data-osd-step=\"\"><h2>基础 <span>HSK 1–3</span></h2><p>讲清六格；用“<span class=\"no-wrap\">每天都……</span>”“<span class=\"no-wrap\">正在……呢</span>”“<span class=\"no-wrap\">从……到……</span>”。</p></article><article class=\"level challenge\" data-osd-step=\"\"><h2>挑战 <span>HSK 4–6</span></h2><p>解释为什么晚到、同学怎样帮忙；把图中事实和自己的想法分开。</p></article></aside></div><p class=\"done\"><b>完成</b> 每人完整讲一次，回答同桌一个问题。</p><footer><span>博雅汉语 · 初级口语活动</span><span>21 / 30</span></footer></section></div>", "<div class=\"os-page\" data-activity=\"12-4\" data-idx=\"21\" data-kind=\"data\" hidden=\"\"><section class=\"activity data\" data-osd-stable-id=\"v02-12-4-data\"><header><div class=\"lesson-tag\">第12课 · 实体课</div><div class=\"activity-label\">活动12-4｜六格漫画：还在路上</div><h1>六格漫画：还在路上</h1><div class=\"rule\"></div></header><div class=\"comic-grid\"><div class=\"comic\" data-osd-step=\"\"><img alt=\"第12课六格漫画，按①至⑥讲述\" src=\"assets/story-lesson-12.png\"/><span class=\"panel-label\" style=\"left:0.0%;top:0%\">① 13:00</span><span class=\"panel-label\" style=\"left:33.333333333333336%;top:0%\">② 13:30</span><span class=\"panel-label\" style=\"left:66.66666666666667%;top:0%\">③ 13:40</span><span class=\"panel-label\" style=\"left:0.0%;top:50%\">④ 13:50</span><span class=\"panel-label\" style=\"left:33.333333333333336%;top:50%\">⑤ 14:00</span><span class=\"panel-label\" style=\"left:66.66666666666667%;top:50%\">⑥ 14:10</span></div><aside class=\"comic-prompts\"><p class=\"context\" data-osd-step=\"\">小林每天坐公共汽车来学校；今天课：14:00—16:00。<br/>人物：蓝衣小林／绿衣小王。</p><h2>讲述提示</h2><p data-osd-step=\"\">③两人做什么？④谁告诉老师？<br/>⑤老师和小林做什么？⑥几点到、晚多久？</p><h2>可用词句</h2><p class=\"words\" data-osd-step=\"\"><span class=\"no-wrap\">每天都……</span>｜<span class=\"no-wrap\">正在……呢</span>｜<span class=\"no-wrap\">从……到……</span>｜等｜打电话｜告诉｜<span class=\"no-wrap\">开始</span></p></aside></div><footer><span>博雅汉语 · 初级口语活动</span><span>22 / 30</span></footer></section></div>", "<div class=\"os-page\" data-activity=\"12-5\" data-idx=\"22\" data-kind=\"task\" hidden=\"\"><section class=\"activity task\" data-osd-stable-id=\"v02-12-5-task\"><header><div class=\"lesson-tag\">第12课 · 实体课</div><div class=\"activity-label\">活动12-5｜问清下周课表</div><h1>问清下周课表</h1><div class=\"rule\"></div></header><p class=\"goal\" data-osd-step=\"\"><span>目标</span>问清上课时间和教室，记住周三的不同。</p><div class=\"task-grid\"><ol class=\"task-steps\"><li data-osd-step=\"\">在纸上写周一、周三、周五。B背对屏幕，A看第二页。</li><li data-osd-step=\"\">B问三天从几点到几点、在哪个教室；A回答，B记录。</li><li data-osd-step=\"\">B复述周三安排，A确认；交换角色再练。</li></ol><aside><article class=\"level base\" data-osd-step=\"\"><h2>基础 <span>HSK 1–3</span></h2><p>三天时间和教室正确；完成一次询问和一次回答。</p></article><article class=\"level challenge\" data-osd-step=\"\"><h2>挑战 <span>HSK 4–6</span></h2><p>主动提醒容易记错的地方；请同桌复述，确认他记对。</p></article></aside></div><p class=\"done\"><b>完成</b> 每人一份三天记录；周三时间、教室正确。</p><footer><span>博雅汉语 · 初级口语活动</span><span>23 / 30</span></footer></section></div>", "<div class=\"os-page\" data-activity=\"12-5\" data-idx=\"23\" data-kind=\"data\" hidden=\"\"><section class=\"activity data\" data-osd-stable-id=\"v02-12-5-data\"><header><div class=\"lesson-tag\">第12课 · 实体课</div><div class=\"activity-label\">活动12-5｜问清下周课表</div><h1>问清下周课表</h1><div class=\"rule\"></div></header><div class=\"material split\"><div class=\"table-side\" data-osd-step=\"\"><table><thead><tr><th>日期</th><th>时间</th><th>教室</th></tr></thead><tbody><tr><td>周一</td><td>8:00—10:00</td><td>108</td></tr><tr><td>周二</td><td>8:00—10:00</td><td>108</td></tr><tr><td>周三</td><td>8:00—10:00</td><td>206</td></tr><tr><td>周四</td><td>8:00—10:00</td><td>108</td></tr><tr><td>周五</td><td>8:00—10:00</td><td>108</td></tr></tbody></table></div><div class=\"question-side\" data-osd-step=\"\"><p>下周中文课</p><p>问：周一／周三／周五从几点到几点上课？在哪个教室？</p><p>确认：每天都在108吗？周三是……，对吗？</p></div></div><footer><span>博雅汉语 · 初级口语活动</span><span>24 / 30</span></footer></section></div>", "<div class=\"os-page\" data-activity=\"12-6\" data-idx=\"24\" data-kind=\"task\" hidden=\"\"><section class=\"activity task\" data-osd-stable-id=\"v02-12-6-task\"><header><div class=\"lesson-tag\">第12课 · 实体课</div><div class=\"activity-label\">活动12-6｜听新通知，更新课表</div><h1>听新通知，更新课表</h1><div class=\"rule\"></div></header><p class=\"goal\" data-osd-step=\"\"><span>目标</span>听懂哪些安排变了，改对时间和教室。</p><div class=\"task-grid\"><ol class=\"task-steps\"><li data-osd-step=\"\">看第二页原课表和四道问题。听老师读新通知，自己记变化。</li><li data-osd-step=\"\">第二遍核对日期、时间、教室；和同桌比较，有分歧再听。</li><li data-osd-step=\"\">各自说周三和周五的新安排；同桌复述，错处重说。</li></ol><aside><article class=\"level base\" data-osd-step=\"\"><h2>基础 <span>HSK 1–3</span></h2><p>记录并说对周三、周五的新时间和教室。</p></article><article class=\"level challenge\" data-osd-step=\"\"><h2>挑战 <span>HSK 4–6</span></h2><p>比较新旧课表；解释用旧课表会犯什么错。</p></article></aside></div><p class=\"done\"><b>完成</b> 每人一份更新记录、一次说明。</p><footer><span>博雅汉语 · 初级口语活动</span><span>25 / 30</span></footer></section></div>", "<div class=\"os-page\" data-activity=\"12-6\" data-idx=\"25\" data-kind=\"data\" hidden=\"\"><section class=\"activity data\" data-osd-stable-id=\"v02-12-6-data\"><header><div class=\"lesson-tag\">第12课 · 实体课</div><div class=\"activity-label\">活动12-6｜听新通知，更新课表</div><h1>听新通知，更新课表</h1><div class=\"rule\"></div></header><div class=\"material split\"><div class=\"table-side\" data-osd-step=\"\"><table><thead><tr><th>日期</th><th>时间</th><th>教室</th></tr></thead><tbody><tr><td>周一、二、四、五</td><td>8:00—10:00</td><td>108</td></tr><tr><td>周三</td><td>8:00—10:00</td><td>206</td></tr></tbody></table><table><thead><tr><th>日期</th><th>新时间</th><th>新教室</th></tr></thead><tbody><tr><td>周三</td><td>　</td><td>　</td></tr><tr><td>周五</td><td>　</td><td>　</td></tr></tbody></table></div><div class=\"question-side\" data-osd-step=\"\"><p>原课表</p><p>听前问题：①周三时间变了吗？教室呢？②周五几点<span class=\"no-wrap\">开始</span>、几点结束？③周五教室变了吗？④周一、二、四变了吗？</p></div></div><footer><span>博雅汉语 · 初级口语活动</span><span>26 / 30</span></footer></section></div>", "<div class=\"os-page\" data-activity=\"12-7\" data-idx=\"26\" data-kind=\"task\" hidden=\"\"><section class=\"activity task\" data-osd-stable-id=\"v02-12-7-task\"><header><div class=\"lesson-tag\">第12课 · 实体课</div><div class=\"activity-label\">活动12-7｜转告新课表，确认听对</div><h1>转告新课表，确认听对</h1><div class=\"rule\"></div></header><p class=\"goal\" data-osd-step=\"\"><span>目标</span>把新课表转告同桌，确认他记对时间和教室。</p><div class=\"task-grid\"><ol class=\"task-steps\"><li data-osd-step=\"\">B先在纸上写周三、周五，再背对屏幕；A看第二页。</li><li data-osd-step=\"\">A告诉B两天的新安排；B听记，复述并问一个确认问题。</li><li data-osd-step=\"\">A纠正错处；交换角色再练。</li></ol><aside><article class=\"level base\" data-osd-step=\"\"><h2>基础 <span>HSK 1–3</span></h2><p>正确说两天的时间和教室，回答确认问题。</p></article><article class=\"level challenge\" data-osd-step=\"\"><h2>挑战 <span>HSK 4–6</span></h2><p>提醒原课表容易让人记错哪里；请同桌复述确认。</p></article></aside></div><p class=\"done\"><b>完成</b> 每人说一次、听一次；两天记录正确。</p><footer><span>博雅汉语 · 初级口语活动</span><span>27 / 30</span></footer></section></div>", "<div class=\"os-page\" data-activity=\"12-7\" data-idx=\"27\" data-kind=\"data\" hidden=\"\"><section class=\"activity data\" data-osd-stable-id=\"v02-12-7-data\"><header><div class=\"lesson-tag\">第12课 · 实体课</div><div class=\"activity-label\">活动12-7｜转告新课表，确认听对</div><h1>转告新课表，确认听对</h1><div class=\"rule\"></div></header><div class=\"material split\"><div class=\"table-side\" data-osd-step=\"\"><table><thead><tr><th>日期</th><th>时间</th><th>教室</th></tr></thead><tbody><tr><td>周一、二、三、四</td><td>8:00—10:00</td><td>108</td></tr><tr><td>周五</td><td>9:00—11:00</td><td>108</td></tr></tbody></table></div><div class=\"question-side\" data-osd-step=\"\"><p>最终课表（讲的人看）</p><p>听者在纸上记：周三／周五 → 从几点到几点 → 教室。</p><p>确认：周三还是8点<span class=\"no-wrap\">开始</span>，对吗？周五是9点<span class=\"no-wrap\">开始</span>，对吗？周三在哪个教室？</p></div></div><footer><span>博雅汉语 · 初级口语活动</span><span>28 / 30</span></footer></section></div>", "<div class=\"os-page\" data-activity=\"12-8\" data-idx=\"28\" data-kind=\"task\" hidden=\"\"><section class=\"activity task\" data-osd-stable-id=\"v02-12-8-task\"><header><div class=\"lesson-tag\">第12课 · 实体课</div><div class=\"activity-label\">活动12-8｜发一条完整消息</div><h1>发一条完整消息</h1><div class=\"rule\"></div></header><p class=\"goal\" data-osd-step=\"\"><span>目标</span>把天气、现在动作和新安排说清楚。</p><div class=\"task-grid\"><ol class=\"task-steps\"><li data-osd-step=\"\">看第二页情境，各自想一条发给同桌的口头消息。</li><li data-osd-step=\"\">轮流说消息；听者复述见面时间和地点，再问一个问题。</li><li data-osd-step=\"\">回答后，把不清楚的消息重新说一遍。</li></ol><aside><article class=\"level base\" data-osd-step=\"\"><h2>基础 <span>HSK 1–3</span></h2><p>说天气、现在在哪儿做什么、新见面时间和地点。</p></article><article class=\"level challenge\" data-osd-step=\"\"><h2>挑战 <span>HSK 4–6</span></h2><p>解释为什么改安排；回答同桌疑问，区分原计划和新计划。</p></article></aside></div><p class=\"done\"><b>完成</b> 每人一条完整消息、一次听者确认和修正。</p><footer><span>博雅汉语 · 初级口语活动</span><span>29 / 30</span></footer></section></div>", "<div class=\"os-page\" data-activity=\"12-8\" data-idx=\"29\" data-kind=\"data\" hidden=\"\"><section class=\"activity data\" data-osd-stable-id=\"v02-12-8-data\"><header><div class=\"lesson-tag\">第12课 · 实体课</div><div class=\"activity-label\">活动12-8｜发一条完整消息</div><h1>发一条完整消息</h1><div class=\"rule\"></div></header><div class=\"material split\"><div class=\"table-side\" data-osd-step=\"\"><table><thead><tr><th>项目</th><th>信息</th></tr></thead><tbody><tr><td>原计划</td><td>下午3:00，学校门口见面，去公园</td></tr><tr><td>下午天气</td><td><span class=\"no-wrap\">阴天</span>、<span class=\"no-wrap\">下雨</span>，27度</td></tr><tr><td>你现在</td><td>宿舍，正在做作业</td></tr><tr><td>新安排</td><td>下午3:00，商场门口见面，一起<span class=\"no-wrap\">逛街</span></td></tr></tbody></table></div><div class=\"question-side\" data-osd-step=\"\"><p>今天星期五，现在下午1:30。</p><p>说清：天气／现在动作／新见面时间地点／活动。</p><p>听者问：我们几点、在哪里见面？为什么不去公园？</p></div></div><footer><span>博雅汉语 · 初级口语活动</span><span>30 / 30</span></footer></section></div>"]
