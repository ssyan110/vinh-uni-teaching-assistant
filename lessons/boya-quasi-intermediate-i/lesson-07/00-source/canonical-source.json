    {
      "id": "short_text_1",
      "printed_pages": [
        61,
        62
      ],
      "audio": "7-4",
      "title": "小张是登山迷",
      "text": "我邻居小张热爱运动，打球、游泳、滑冰样样都会，令人羡慕。不过，他最大的爱好是登山，是个地地道道的登山迷。一说起登山，他就兴奋得眼睛发亮。",
      "exercises": {
        "first_listen": [
          "小张喜欢什么？",
          "小张最大的爱好是什么？",
          "小张小时候怎么样？"
        ],
        "second_listen": [
          "谈起登山，小张怎么样？（兴奋）",
          "小张小时候为什么不喜欢登山？（很早 饿着肚子 感受）",
          "小张什么时候爱上登山的？（毕业 开始）"
        ],
        "present": "谈谈小张的爱好是什么。",
        "compare": "小张的爱好和登山带来的好处。"
      },
      "exercise_metadata": {
        "first_listen": {
          "heading_verbatim": "（一）听第一遍，简单回答问题",
