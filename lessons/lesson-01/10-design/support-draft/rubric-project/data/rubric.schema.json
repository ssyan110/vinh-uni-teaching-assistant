{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Boya PBI course-adapted learning feedback tool",
  "type": "object",
  "additionalProperties": false,
  "required": ["rubric", "criteria", "student_compact", "task_completion"],
  "properties": {
    "rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title_zh_cn",
        "status",
        "official_actfl_rating",
        "legal_notice_zh_cn",
        "scale",
        "modes",
        "task_completion",
        "retry",
        "feedback_use"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title_zh_cn": {"type": "string", "minLength": 1},
        "status": {"type": "string", "const": "course_adapted_formative_feedback_non_grading"},
        "official_actfl_rating": {"type": "boolean", "const": false},
        "legal_notice_zh_cn": {"type": "string", "minLength": 1},
        "scale": {
          "type": "object",
          "additionalProperties": false,
          "required": ["values", "special_codes", "actfl_level_mapping"],
          "properties": {
            "values": {
              "type": "array",
              "const": [0, 1, 2, 3]
            },
            "special_codes": {
              "type": "array",
              "items": {"type": "string", "enum": ["NR", "N/A"]},
              "minItems": 2,
              "uniqueItems": true
            },
            "actfl_level_mapping": {"type": "null"}
          }
        },
        "modes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["interpretive", "interpersonal", "presentational"],
          "properties": {
            "interpretive": {"$ref": "#/definitions/mode"},
            "interpersonal": {"$ref": "#/definitions/mode"},
            "presentational": {"$ref": "#/definitions/mode"}
          }
        },
        "task_completion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_score", "included_in_school_grade"],
          "properties": {
            "max_score": {"type": "integer", "const": 3},
            "included_in_school_grade": {"type": "boolean", "const": false}
          }
        },
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["store_attempts_separately", "default_policy"],
          "properties": {
            "store_attempts_separately": {"type": "boolean", "const": true},
            "default_policy": {"type": "string", "const": "keep_both"}
          }
        },
        "feedback_use": {
          "type": "object",
          "additionalProperties": false,
          "required": ["school_grading", "purpose_zh_cn"],
          "properties": {
            "school_grading": {"type": "boolean", "const": false},
            "purpose_zh_cn": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "criteria": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {"$ref": "#/definitions/criterion"}
    },
    "student_compact": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/definitions/compactCriterion"}
    },
    "task_completion": {
      "$ref": "#/definitions/taskCompletion"
    }
  },
  "definitions": {
    "mode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion_count", "criteria"],
      "properties": {
        "criterion_count": {"type": "integer", "const": 5},
        "criteria": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {"type": "string", "minLength": 2}
        }
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "mode",
        "title_zh_cn",
        "scores",
        "source_construct",
        "source_ids",
        "source_pages_or_sections",
        "task_specific_part",
        "adaptation_note_zh_tw",
        "student_language"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^(I[1-5]|P[1-5]|PR[1-5])$"},
        "mode": {"type": "string", "enum": ["interpretive", "interpersonal", "presentational"]},
        "title_zh_cn": {"type": "string", "minLength": 1},
        "scores": {
          "type": "object",
          "additionalProperties": false,
          "required": ["0", "1", "2", "3"],
          "properties": {
            "0": {"type": "string", "minLength": 1},
            "1": {"type": "string", "minLength": 1},
            "2": {"type": "string", "minLength": 1},
            "3": {"type": "string", "minLength": 1}
          }
        },
        "source_construct": {"type": "string", "minLength": 1},
        "source_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "^S[0-9]{2}$"},
          "minItems": 1,
          "uniqueItems": true
        },
        "source_pages_or_sections": {"type": "string", "minLength": 1},
        "task_specific_part": {"type": "string", "minLength": 1},
        "adaptation_note_zh_tw": {"type": "string", "minLength": 1},
        "student_language": {"type": "string", "const": "zh-CN"}
      }
    },
    "compactCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title_zh_cn", "scores", "official_or_adapted_note"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title_zh_cn": {"type": "string", "minLength": 1},
        "scores": {
          "type": "object",
          "additionalProperties": false,
          "required": ["0", "1", "2", "3"],
          "properties": {
            "0": {"type": "string", "minLength": 1},
            "1": {"type": "string", "minLength": 1},
            "2": {"type": "string", "minLength": 1},
            "3": {"type": "string", "minLength": 1}
          }
        },
        "official_or_adapted_note": {"type": "string", "minLength": 1}
      }
    },
    "taskCompletion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title_zh_cn", "classification", "included_in_school_grade", "scores"],
      "properties": {
        "id": {"type": "string", "const": "task_completion"},
        "title_zh_cn": {"type": "string", "minLength": 1},
        "classification": {"type": "string", "const": "task_specific_criterion"},
        "included_in_school_grade": {"type": "boolean", "const": false},
        "scores": {
          "type": "object",
          "additionalProperties": false,
          "required": ["0", "1", "2", "3", "NR"],
          "properties": {
            "0": {"type": "string", "minLength": 1},
            "1": {"type": "string", "minLength": 1},
            "2": {"type": "string", "minLength": 1},
            "3": {"type": "string", "minLength": 1},
            "NR": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
