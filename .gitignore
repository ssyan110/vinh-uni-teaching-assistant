# OS files
.DS_Store
~$*

# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Playwright / test artifacts
playwright-report/
test-results/
/.playwright-cli/

# GitHub file-size limit; extracted approval evidence remains in the archive
lessons/boya-intermediate-i/lesson-01/90-archive/approval-evidence-2026-08-27/social-appellation-supplement-v11/第一课-主任审核包-含文化补充-v11-final.zip

# Project-local agent harness. Keep durable contracts and skills versioned;
# individual run packets are local execution evidence and stay untracked.
.agent/*
!.agent/agent-workflow-index.md
!.agent/agent-operating-contract.md
!.agent/skills/
.agent/skills/*
!.agent/skills/README.md
!.agent/skills/harness-engineering/
!.agent/skills/harness-engineering/SKILL.md
!.agent/skills/boya-lesson-production/
!.agent/skills/boya-lesson-production/SKILL.md
!.agent/runs/
.agent/runs/*
!.agent/runs/README.md

# Local temp/cache
.cache/
.tmp/
tmp/
# Root-level render and QA scratch artifacts
/.tmp*
/.l*
**/.DS_Store
**/*-DS_Store

# Working files (OCR, PDFs, intermediate)
work/

# The former root output tree is archived; new material belongs in lessons/
/output/

# Source textbook PDFs (local inputs; too large for git)
Giáo trình/
Giáo trình/
Giáo trình full/

# Standardized textbook source locations. Metadata, QR captures, and provenance
# stay tracked; publisher PDFs and downloaded audio remain local-only inputs.
/textbooks/*/source/raw/
/textbooks/*/source/audio/**/*.mp3
/textbooks/*/source/audio/**/*.part
/textbooks/*/source/derived/
