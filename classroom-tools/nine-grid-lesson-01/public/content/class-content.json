  "sentences": [
    { "item_id": "E01-004-1", "sentence": "我叫徐幼华，按照英文的习惯，姓要放在名后，读幼华徐。", "introduced_lesson_id": "lesson-01-listening-1", "source_record_id": "E01-004", "textbook_printed_page": 4, "active": true },
    { "item_id": "E01-004-2", "sentence": "请问你的名字怎么念？", "introduced_lesson_id": "lesson-01-listening-1", "source_record_id": "E01-004", "textbook_printed_page": 4, "active": true },
    { "item_id": "E01-004-3", "sentence": "日本人很多都叫什么子，第几郎。", "introduced_lesson_id": "lesson-01-listening-1", "source_record_id": "E01-004", "textbook_printed_page": 4, "active": true },
    { "item_id": "E01-004-4", "sentence": "南美洲来的不是叫荷西，就是叫玛丽亚。", "introduced_lesson_id": "lesson-01-listening-1", "source_record_id": "E01-004", "textbook_printed_page": 4, "active": true },
    { "item_id": "E01-004-5", "sentence": "我给她起了个中文名字叫汉云，意思是汉唐飘过来的一片云。", "introduced_lesson_id": "lesson-01-listening-1", "source_record_id": "E01-004", "textbook_printed_page": 4, "active": true },
    { "item_id": "E01-004-6", "sentence": "广东人常说“不怕人错行，就怕起错名”。", "introduced_lesson_id": "lesson-01-listening-1", "source_record_id": "E01-004", "textbook_printed_page": 4, "active": true },
    { "item_id": "E01-005-1", "sentence": "中国男孩子为什么叫“强”的人很多？", "introduced_lesson_id": "lesson-01-listening-1", "source_record_id": "E01-005", "textbook_printed_page": 4, "active": true },
    { "item_id": "E01-005-2", "sentence": "你为什么叫震生？", "introduced_lesson_id": "lesson-01-listening-1", "source_record_id": "E01-005", "textbook_printed_page": 4, "active": true },
    { "item_id": "E01-005-3", "sentence": "你名字里的“川”是不是川菜的“川”呀？", "introduced_lesson_id": "lesson-01-listening-1", "source_record_id": "E01-005", "textbook_printed_page": 4, "active": true },
    { "item_id": "E01-022-1", "sentence": "你们中国人不是都叫陈什么吗？", "introduced_lesson_id": "lesson-01-listening-2", "source_record_id": "E01-022", "textbook_printed_page": 11, "active": true },
    { "item_id": "E01-022-2", "sentence": "你的姓译成另一种语言，很可能变成一个让人啼笑皆非的笑话。", "introduced_lesson_id": "lesson-01-listening-2", "source_record_id": "E01-022", "textbook_printed_page": 11, "active": true },
    { "item_id": "E01-022-3", "sentence": "哎呀，姓什么不好，偏偏要姓贾！", "introduced_lesson_id": "lesson-01-listening-2", "source_record_id": "E01-022", "textbook_printed_page": 11, "active": true },
    { "item_id": "E01-022-4", "sentence": "我姓常，你姓江，我们的孩子干脆就叫常江吧。", "introduced_lesson_id": "lesson-01-listening-2", "source_record_id": "E01-022", "textbook_printed_page": 11, "active": true },
    { "item_id": "E01-022-5", "sentence": "他听说我也姓李，连忙大声说“咱俩五百年前是一家”。", "introduced_lesson_id": "lesson-01-listening-2", "source_record_id": "E01-022", "textbook_printed_page": 11, "active": true }
  ],
  "exercises": [
