    { "item_id": "FUNC-E01-005-3", "function_kind": "pattern-make", "prompt": "A：你名字里的“川”是不是川菜的“川”呀？\nB：________", "instruction": "先回答 A，再用题目中的词说一句。", "introduced_lesson_id": "lesson-01-listening-1", "source_record_id": "E01-005", "textbook_printed_page": 4, "active": true },
    { "item_id": "FUNC-E01-009-1", "function_kind": "dialogue-pattern", "prompt": "A：你们先去吃吧，我打印完这份文件再去吃。\nB：________", "instruction": "用“总不能……吧”回答，再用这个句式造一句。", "introduced_lesson_id": "lesson-01-listening-1", "source_record_id": "E01-009", "textbook_printed_pages": [6, 7], "active": true },
    { "item_id": "FUNC-E01-009-2", "function_kind": "dialogue-pattern", "prompt": "A：这几件衣服我都很喜欢，怎么办呢？\nB：________", "instruction": "用“总不能……吧”回答，再用这个句式造一句。", "introduced_lesson_id": "lesson-01-listening-1", "source_record_id": "E01-009", "textbook_printed_pages": [6, 7], "active": true },
    { "item_id": "FUNC-E01-009-3", "function_kind": "dialogue-pattern", "prompt": "A：我认为，学生应该努力学习，不能出去打工。\nB：________", "instruction": "用“总不能……吧”回答，再用这个句式造一句。", "introduced_lesson_id": "lesson-01-listening-1", "source_record_id": "E01-009", "textbook_printed_pages": [6, 7], "active": true },
    { "item_id": "FUNC-E01-010-1", "function_kind": "sentence-rewrite", "prompt": "你不懂外语，又不懂电脑，肯定找不到好工作。", "instruction": "用“……才怪呢”改写。", "introduced_lesson_id": "lesson-01-listening-1", "review_lesson_ids": ["lesson-01-listening-2"], "source_record_id": "E01-010", "textbook_printed_page": 7, "active": true },
    { "item_id": "FUNC-E01-010-2", "function_kind": "sentence-rewrite", "prompt": "你每天吃那么多，怎么可能不胖呢？", "instruction": "用“……才怪呢”改写。", "introduced_lesson_id": "lesson-01-listening-1", "review_lesson_ids": ["lesson-01-listening-2"], "source_record_id": "E01-010", "textbook_printed_page": 7, "active": true },
    { "item_id": "FUNC-E01-010-3", "function_kind": "sentence-rewrite", "prompt": "他每天晚上在外面喝酒，他太太当然会生他的气呀！", "instruction": "用“……才怪呢”改写。", "introduced_lesson_id": "lesson-01-listening-1", "review_lesson_ids": ["lesson-01-listening-2"], "source_record_id": "E01-010", "textbook_printed_page": 7, "active": true },
    { "item_id": "FUNC-E01-011-1", "function_kind": "pattern-make", "prompt": "到时候别忘了通知我。", "instruction": "先说出使用情境，再用“到时候”造一句。", "introduced_lesson_id": "lesson-01-listening-1", "source_record_id": "E01-011", "textbook_printed_page": 7, "active": true },
    { "item_id": "FUNC-E01-011-2", "function_kind": "pattern-make", "prompt": "到时候哭都来不及。", "instruction": "先说出使用情境，再用“到时候”造一句。", "introduced_lesson_id": "lesson-01-listening-1", "source_record_id": "E01-011", "textbook_printed_page": 7, "active": true },
    { "item_id": "FUNC-E01-012-1", "function_kind": "pattern-make", "prompt": "网络对现代生活的影响", "instruction": "用“话说回来”从两个角度说一说。", "introduced_lesson_id": "lesson-01-listening-1", "source_record_id": "E01-012", "textbook_printed_page": 7, "active": true },
    { "item_id": "FUNC-E01-012-2", "function_kind": "pattern-make", "prompt": "减肥与身体健康", "instruction": "用“话说回来”从两个角度说一说。", "introduced_lesson_id": "lesson-01-listening-1", "source_record_id": "E01-012", "textbook_printed_page": 7, "active": true },
    { "item_id": "FUNC-G01-005", "function_kind": "pattern-make", "prompt": "不然", "instruction": "读句式后，用这个句式造一句话。", "introduced_lesson_id": "lesson-01-listening-2", "source_record_id": "G01-005", "textbook_printed_page": 13, "active": true },
    { "item_id": "FUNC-G01-006", "function_kind": "pattern-make", "prompt": "是……还是……", "instruction": "读句式后，用这个句式造一句话。", "introduced_lesson_id": "lesson-01-listening-2", "source_record_id": "G01-006", "textbook_printed_page": 13, "active": true },
    { "item_id": "FUNC-G01-007", "function_kind": "pattern-make", "prompt": "怎么……怎么……", "instruction": "读句式后，用这个句式造一句话。", "introduced_lesson_id": "lesson-01-listening-2", "source_record_id": "G01-007", "textbook_printed_page": 13, "active": true },
    { "item_id": "FUNC-E01-021-1", "function_kind": "pattern-make", "prompt": "做父母的，总要为子女操心，请说说你让父母最操心的几件事。", "instruction": "用题目中的词语回答，再补充一句。", "introduced_lesson_id": "lesson-01-listening-2", "source_record_id": "E01-021", "textbook_printed_page": 11, "active": true },
    { "item_id": "FUNC-E01-021-2", "function_kind": "pattern-make", "prompt": "你来中国以后，做过哪些让人啼笑皆非的事情？", "instruction": "用题目中的词语回答，再补充一句。", "introduced_lesson_id": "lesson-01-listening-2", "source_record_id": "E01-021", "textbook_printed_page": 11, "active": true },
    { "item_id": "FUNC-E01-021-3", "function_kind": "pattern-make", "prompt": "说出几个你们国家很少见的姓。", "instruction": "用题目中的词语回答，再补充一句。", "introduced_lesson_id": "lesson-01-listening-2", "source_record_id": "E01-021", "textbook_printed_page": 11, "active": true },
    { "item_id": "FUNC-E01-021-4", "function_kind": "pattern-make", "prompt": "在你们国家的语言中，有没有对老年人的尊称？简单介绍一下。", "instruction": "用题目中的词语回答，再补充一句。", "introduced_lesson_id": "lesson-01-listening-2", "source_record_id": "E01-021", "textbook_printed_page": 11, "active": true },
    { "item_id": "FUNC-E01-021-5", "function_kind": "pattern-make", "prompt": "在中国，人与人之间最常见的称呼是什么？", "instruction": "用题目中的词语回答，再补充一句。", "introduced_lesson_id": "lesson-01-listening-2", "source_record_id": "E01-021", "textbook_printed_page": 11, "active": true },
    { "item_id": "FUNC-E01-021-6", "function_kind": "pattern-make", "prompt": "在和陌生人交往的时候，应该注意什么？", "instruction": "用题目中的词语回答，再补充一句。", "introduced_lesson_id": "lesson-01-listening-2", "source_record_id": "E01-021", "textbook_printed_page": 11, "active": true },
    { "item_id": "FUNC-E01-022-1", "function_kind": "pattern-make", "prompt": "你们中国人不是都叫陈什么吗？", "instruction": "跟读句子，替换画线词语说一句。", "introduced_lesson_id": "lesson-01-listening-2", "source_record_id": "E01-022", "textbook_printed_page": 11, "active": true },
    { "item_id": "FUNC-E01-022-2", "function_kind": "pattern-make", "prompt": "你的姓译成另一种语言，很可能变成一个让人啼笑皆非的笑话。", "instruction": "跟读句子，替换画线词语说一句。", "introduced_lesson_id": "lesson-01-listening-2", "source_record_id": "E01-022", "textbook_printed_page": 11, "active": true },
    { "item_id": "FUNC-E01-022-3", "function_kind": "pattern-make", "prompt": "哎呀，姓什么不好，偏偏要姓贾！", "instruction": "跟读句子，替换画线词语说一句。", "introduced_lesson_id": "lesson-01-listening-2", "source_record_id": "E01-022", "textbook_printed_page": 11, "active": true },
    { "item_id": "FUNC-E01-022-4", "function_kind": "pattern-make", "prompt": "我姓常，你姓江，我们的孩子干脆就叫常江吧。", "instruction": "跟读句子，替换画线词语说一句。", "introduced_lesson_id": "lesson-01-listening-2", "source_record_id": "E01-022", "textbook_printed_page": 11, "active": true },
    { "item_id": "FUNC-E01-022-5", "function_kind": "pattern-make", "prompt": "他听说我也姓李，连忙大声说“咱俩五百年前是一家”。", "instruction": "跟读句子，替换画线词语说一句。", "introduced_lesson_id": "lesson-01-listening-2", "source_record_id": "E01-022", "textbook_printed_page": 11, "active": true },
    { "item_id": "FUNC-E01-023-1", "function_kind": "dialogue-pattern", "prompt": "A：您贵姓？\nB：________", "instruction": "用“是……还是……”回答，再用这个句式造一句。", "introduced_lesson_id": "lesson-01-listening-2", "source_record_id": "E01-023", "textbook_printed_page": 12, "active": true },
    { "item_id": "FUNC-E01-023-2", "function_kind": "dialogue-pattern", "prompt": "A：你好！我姓张，弓长张。\nB：________", "instruction": "用“是……还是……”回答，再用这个句式造一句。", "introduced_lesson_id": "lesson-01-listening-2", "source_record_id": "E01-023", "textbook_printed_page": 12, "active": true },
    { "item_id": "FUNC-E01-023-3", "function_kind": "dialogue-pattern", "prompt": "A：诸先生，很高兴认识您。\nB：________", "instruction": "用“是……还是……”回答，再用这个句式造一句。", "introduced_lesson_id": "lesson-01-listening-2", "source_record_id": "E01-023", "textbook_printed_page": 12, "active": true },
    { "item_id": "FUNC-E01-023-4", "function_kind": "dialogue-pattern", "prompt": "A：您姓zhāng？哪个zhāng？\nB：________", "instruction": "用“是……还是……”回答，再用这个句式造一句。", "introduced_lesson_id": "lesson-01-listening-2", "source_record_id": "E01-023", "textbook_printed_page": 12, "active": true },
    { "item_id": "FUNC-E01-023-5", "function_kind": "dialogue-pattern", "prompt": "A：你的女朋友姓什么？\nB：________", "instruction": "用“是……还是……”回答，再用这个句式造一句。", "introduced_lesson_id": "lesson-01-listening-2", "source_record_id": "E01-023", "textbook_printed_page": 12, "active": true },
    { "item_id": "FUNC-E01-027-1", "function_kind": "pattern-make", "prompt": "我们必须马上出发，不然________。", "instruction": "先补充句子，再用“不然”另造一句。", "introduced_lesson_id": "lesson-01-listening-2", "source_record_id": "E01-027", "textbook_printed_page": 14, "active": true },
    { "item_id": "FUNC-E01-027-2", "function_kind": "pattern-make", "prompt": "你一定要好好儿复习，不然________。", "instruction": "先补充句子，再用“不然”另造一句。", "introduced_lesson_id": "lesson-01-listening-2", "source_record_id": "E01-027", "textbook_printed_page": 14, "active": true },
    { "item_id": "FUNC-E01-027-3", "function_kind": "pattern-make", "prompt": "夏天出门一定要带雨伞，不然________。", "instruction": "先补充句子，再用“不然”另造一句。", "introduced_lesson_id": "lesson-01-listening-2", "source_record_id": "E01-027", "textbook_printed_page": 14, "active": true },
    { "item_id": "FUNC-E01-027-4", "function_kind": "pattern-make", "prompt": "颐和园／圆明园", "instruction": "用“是……还是……”提出问题。", "introduced_lesson_id": "lesson-01-listening-2", "source_record_id": "E01-027", "textbook_printed_page": 14, "active": true },
    { "item_id": "FUNC-E01-027-5", "function_kind": "pattern-make", "prompt": "坐车／骑车", "instruction": "用“是……还是……”提出问题。", "introduced_lesson_id": "lesson-01-listening-2", "source_record_id": "E01-027", "textbook_printed_page": 14, "active": true },
    { "item_id": "FUNC-E01-027-6", "function_kind": "pattern-make", "prompt": "上北大／上清华", "instruction": "用“是……还是……”提出问题。", "introduced_lesson_id": "lesson-01-listening-2", "source_record_id": "E01-027", "textbook_printed_page": 14, "active": true },
    { "item_id": "FUNC-E01-027-7", "function_kind": "pattern-make", "prompt": "________", "instruction": "用“怎么……怎么……”造句。", "introduced_lesson_id": "lesson-01-listening-2", "source_record_id": "E01-027", "textbook_printed_page": 14, "active": true },
    { "item_id": "FUNC-E01-027-8", "function_kind": "pattern-make", "prompt": "________", "instruction": "用“怎么……怎么……”造句。", "introduced_lesson_id": "lesson-01-listening-2", "source_record_id": "E01-027", "textbook_printed_page": 14, "active": true },
    { "item_id": "FUNC-E01-027-9", "function_kind": "pattern-make", "prompt": "________", "instruction": "用“怎么……怎么……”造句。", "introduced_lesson_id": "lesson-01-listening-2", "source_record_id": "E01-027", "textbook_printed_page": 14, "active": true }
  ]
