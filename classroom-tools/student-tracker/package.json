{
  "name": "keji-student-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build --base ./",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "desktop:package": "node -e \"console.error('旧桌面工具已停用，请使用学生管理系统网页。'); process.exit(1)\"",
    "desktop:install": "node -e \"console.error('旧桌面工具已停用，请使用学生管理系统网页。'); process.exit(1)\""
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.0",
    "electron": "^38.1.0",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.0"
  }
}
